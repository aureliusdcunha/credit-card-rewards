{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credit-card-rewards-intelligence",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "credit-card-rewards",
      "database_id": "b57383f5-81bd-4cc3-a52b-d7266edb246d",
      "migrations_dir": "migrations"
    }
  ]
}
