{
  "name": "credit-card-rewards-intelligence",
  "version": "0.6.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.jsonc",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create credit-card-rewards",
    "db:migrate:local": "wrangler d1 migrations apply credit-card-rewards --local",
    "db:migrate:remote": "wrangler d1 migrations apply credit-card-rewards --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
